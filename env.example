# Telegram Bot Token (получите у @BotFather)
BOT_TOKEN=your_bot_token_here

# Telegram Mini App: public HTTPS URL routed to this bot's HTTP server.
MINI_APP_URL=https://bot.dsipsmule.one
MINI_APP_HOST=0.0.0.0
MINI_APP_PORT=8080
# Telegram sessions older than this require reopening the app (seconds).
MINI_APP_AUTH_MAX_AGE=3600

# ID канала (начинается с -100)
CHANNEL_ID=your_channel_id_here

# ID группы (начинается с -100)
GROUP_ID=your_group_id_here

# ID разрешенных групп (через запятую)
ALLOWED_GROUP_ID=your_group_id_here

# Free Groq API: text and voice transcription. Keep credentials in Secret env.
GROQ_API_KEY=
GROQ_TEXT_MODEL=openai/gpt-oss-20b
GROQ_SPEECH_MODEL=whisper-large-v3-turbo
# Temporary: comment on every eligible new group text. Use 0.1 for 10%, 0 for direct requests only.
AI_REPLY_PROBABILITY=1.0
# Cloudflare Workers AI Free: FLUX.2 Klein 4B, 1024x1024 (~95 images/day).
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-2-klein-4b
# Optional alternative: @cf/black-forest-labs/flux-2-klein-9b (~7/day).

# ID администраторов (через запятую)
ADMINS=admin_id1,admin_id2

# Imgur Client ID (для загрузки изображений)
IMGUR_CLIENT_ID=your_imgur_client_id

# Character AI Token (для AI-персонажа)
CHARACTER_AI_TOKEN=your_character_ai_token

# Character AI ID и Voice ID
CHARACTER_ID=your_character_id
CHARACTER_VOICE_ID=your_voice_id

# Source for "Песня дня" from Smule.
# By default the bot uses:
# https://www.smule.com/api/profile/performances?accountId=96242367&appUid=sing&offset=0&limit=12
# Optional: override with a direct performances URL
SMULE_PERFORMANCES_URL=
# Optional: override accountId only
SMULE_ACCOUNT_ID=
# Optional: additional public profile fallback
SMULE_USERNAME=

# Hall of fame: S3 is authoritative; DATA_DIR contains a disposable local cache.
S3_ENDPOINT_URL=https://nbg1.your-objectstorage.com
S3_REGION=nbg1
S3_BUCKET=dsipsmule
HALL_S3_KEY=dsipsmule-bot/hall/hall.csv
S3_ACCESS_KEY_ID=your_s3_access_key
S3_SECRET_ACCESS_KEY=your_s3_secret_key
# Optional: personal Last.fm API key (overrides the existing key).
LASTFM_API_KEY=
